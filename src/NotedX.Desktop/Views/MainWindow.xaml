<ui:FluentWindow
    x:Class="NotedX.Desktop.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:NotedX.Desktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1240"
    d:DesignHeight="800"
    Title="noted-x"
    Width="1220"
    Height="800"
    MinWidth="960"
    MinHeight="620"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    Background="Transparent"
    UseLayoutRounding="True"
    FontFamily="{StaticResource BodyFontFamily}"
    FontSize="14"
    Closing="OnWindowClosing"
    PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <DataTemplate x:Key="ToastTemplate">
            <Border Style="{StaticResource ToastCardStyle}" Margin="0,8,0,0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1"
                                                 Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="26" Height="26" CornerRadius="13"
                            VerticalAlignment="Top"
                            Background="{Binding Kind, Converter={StaticResource ToastKindToBrush}, ConverterParameter=soft}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding Kind, Converter={StaticResource ToastKindToBrush}}"
                                   Text="{Binding Kind, Converter={StaticResource ToastKindToGlyph}}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding Title}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Message}" />
                    </StackPanel>

                    <ui:Button Grid.Column="2"
                               VerticalAlignment="Top"
                               Style="{StaticResource SmallIconButtonStyle}"
                               ToolTip="Dismiss"
                               Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                               CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="10" />
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="noted-x" ShowHelp="False">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                    <ui:Button Style="{StaticResource IconButtonStyle}"
                               Width="30" Height="30"
                               ToolTip="Toggle sidebar"
                               Command="{Binding ToggleSidebarCommand}">
                        <ui:SymbolIcon Symbol="PanelLeft24" FontSize="14" />
                    </ui:Button>

                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding PageHeader}" />
                </StackPanel>
            </ui:TitleBar.Header>

            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Style="{StaticResource IconButtonStyle}"
                               ToolTip="Search (Ctrl+K)"
                               Command="{Binding OpenSearchCommand}">
                        <ui:SymbolIcon Symbol="Search24" FontSize="14" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource IconButtonStyle}"
                               ToolTip="Pair a phone"
                               Command="{Binding OpenPairingCommand}">
                        <ui:SymbolIcon Symbol="Phone24" FontSize="14" />
                    </ui:Button>

                    <Grid>
                        <ui:Button Style="{StaticResource IconButtonStyle}"
                                   ToolTip="Transfers"
                                   Command="{Binding ToggleTransfersCommand}">
                            <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="14" />
                        </ui:Button>
                        <Border MinWidth="15" Height="15"
                                Padding="3,0"
                                CornerRadius="8"
                                Background="{StaticResource BrandBrush}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,3,1,0"
                                IsHitTestVisible="False"
                                Visibility="{Binding Transfers.HasActive, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="9" FontWeight="SemiBold" Foreground="White"
                                       Text="{Binding Transfers.ActiveCount}" />
                        </Border>
                    </Grid>

                    <ui:Button Style="{StaticResource IconButtonStyle}"
                               ToolTip="Switch light or dark theme"
                               Command="{Binding ToggleThemeCommand}">
                        <ui:SymbolIcon FontSize="14">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="{x:Type ui:SymbolIcon}">
                                    <Setter Property="Symbol" Value="WeatherMoon24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                            <Setter Property="Symbol" Value="WeatherSunny24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </ui:Button>

                    <ui:Button Style="{StaticResource IconButtonStyle}"
                               ToolTip="Settings"
                               Command="{Binding OpenSettingsCommand}">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="14" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:SidebarView Grid.Column="0">
                <views:SidebarView.Style>
                    <Style TargetType="{x:Type views:SidebarView}">
                        <Setter Property="Width" Value="260" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="76" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SidebarView.Style>
            </views:SidebarView>

            <Grid Grid.Column="1">
                <views:HomeView Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVisibility}}" />

                <views:EditorView DataContext="{Binding Editor}"
                                  Visibility="{Binding DataContext.IsEditorVisible, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVisibility}}" />

                <views:TrashView Visibility="{Binding IsTrashVisible, Converter={StaticResource BoolToVisibility}}" />

                <views:FilesView DataContext="{Binding Files}"
                                 Visibility="{Binding DataContext.IsFilesVisible, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVisibility}}" />

                <views:TransfersPanel HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,10,14,0"
                                     Panel.ZIndex="6"
                                     DataContext="{Binding}"
                                     Visibility="{Binding IsTransfersOpen, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>

        <views:SearchOverlay Grid.RowSpan="2"
                             Panel.ZIndex="20"
                             DataContext="{Binding}"
                             Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVisibility}}" />

        <views:PairingView Grid.RowSpan="2"
                           Panel.ZIndex="21"
                           DataContext="{Binding}"
                           Visibility="{Binding IsPairingOpen, Converter={StaticResource BoolToVisibility}}" />

        <views:SettingsView Grid.RowSpan="2"
                            Panel.ZIndex="22"
                            DataContext="{Binding}"
                            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl Grid.RowSpan="2"
                      Panel.ZIndex="30"
                      Width="360"
                      Margin="0,0,18,18"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      ItemsSource="{Binding Toasts.Items}"
                      ItemTemplate="{StaticResource ToastTemplate}" />
    </Grid>
</ui:FluentWindow>
