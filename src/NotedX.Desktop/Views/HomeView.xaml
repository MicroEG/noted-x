<UserControl x:Class="NotedX.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="920"
             d:DesignHeight="720">

    <UserControl.Resources>
        <Style x:Key="NoteCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickActionStyle" TargetType="Button" BasedOn="{StaticResource SlashItemButtonStyle}">
            <Setter Property="Padding" Value="10,9" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
        <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
              MaxWidth="860"
              Margin="44,30,44,42"
              HorizontalAlignment="Center">
            <StackPanel>

                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="YOUR PRIVATE WORKSPACE" />

                <TextBlock Margin="0,6,0,0"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="Your notes, on your network." />

                <TextBlock Margin="0,8,0,0"
                           MaxWidth="620"
                           HorizontalAlignment="Left"
                           FontSize="14.5"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding PrivacyNote}" />

                <WrapPanel Margin="0,20,0,0" Orientation="Horizontal">
                    <ui:Button Height="38" Padding="16,0" CornerRadius="9"
                               Appearance="Primary"
                               Command="{Binding NewPageCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="15" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="New note" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Height="38" Margin="8,0,0,0" Padding="14,0" CornerRadius="9"
                               Appearance="Secondary"
                               Command="{Binding ImportMarkdownCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="15" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Import Markdown" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Height="38" Margin="8,0,0,0" Padding="14,0" CornerRadius="9"
                               Appearance="Secondary"
                               Command="{Binding OpenPairingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Phone24" FontSize="15" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Pair a phone" />
                        </StackPanel>
                    </ui:Button>
                </WrapPanel>

                <WrapPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource PillStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="12"
                                           Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Margin="6,0,0,0" Style="{StaticResource SmallMutedTextStyle}" Text="No cloud" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PillStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="12"
                                           Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Margin="6,0,0,0" Style="{StaticResource SmallMutedTextStyle}" Text="No telemetry" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PillStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Wifi124" FontSize="12"
                                           Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Margin="6,0,0,0" Style="{StaticResource SmallMutedTextStyle}" Text="LAN only" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Grid Margin="0,32,0,0">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="Recent notes" />
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource SmallMutedTextStyle}"
                               Text="The last six notes you touched" />
                </Grid>

                <ItemsControl Margin="0,12,0,0"
                              ItemsSource="{Binding RecentPages}"
                              Visibility="{Binding HasRecentPages, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="282" Height="74" Margin="0,0,10,10"
                                    Style="{StaticResource NoteCardButtonStyle}"
                                    Command="{Binding DataContext.OpenNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="9"
                                            Background="{StaticResource BrandSofterBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="17" Text="{Binding Icon}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{Binding Title}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource SmallMutedTextStyle}"
                                                   Text="{Binding UpdatedText}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,2,0,0"
                        Style="{StaticResource SoftCardStyle}"
                        Padding="20"
                        Visibility="{Binding HasRecentPages, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="A blank page is waiting" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="Create your first note, import existing Markdown, or pair a phone and start writing from the couch." />
                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                            <ui:Button Appearance="Primary" Padding="14,6" CornerRadius="8"
                                       Content="Create a note"
                                       Command="{Binding NewPageCommand}" />
                            <ui:Button Margin="8,0,0,0" Appearance="Secondary" Padding="14,6" CornerRadius="8"
                                       Content="Import Markdown"
                                       Command="{Binding ImportMarkdownCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="8"
                                        Background="{StaticResource BrandSofterBrush}">
                                    <ui:SymbolIcon Symbol="PhoneDesktop24" FontSize="14"
                                                   Foreground="{StaticResource BrandBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource SectionTitleStyle}" FontSize="15"
                                           Text="This device" />
                            </StackPanel>

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource MutedTextStyle}"
                                       Text="Local server" />
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServerRunning}" Value="False">
                                                    <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding ServerSummary}" />
                            </Grid>

                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="Phones open the address above in a browser. Nothing leaves your Wi-Fi." />

                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <ui:Button Appearance="Secondary" Padding="12,6" CornerRadius="8"
                                           Content="Pair a phone"
                                           Command="{Binding OpenPairingCommand}" />
                                <ui:Button Margin="8,0,0,0" Appearance="Transparent" Padding="10,6" CornerRadius="8"
                                           Content="Settings"
                                           Command="{Binding OpenSettingsCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="8"
                                        Background="{StaticResource BrandSofterBrush}">
                                    <ui:SymbolIcon Symbol="Rocket24" FontSize="14"
                                                   Foreground="{StaticResource BrandBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource SectionTitleStyle}" FontSize="15"
                                           Text="Quick actions" />
                            </StackPanel>

                            <Button Margin="0,10,0,0" Style="{StaticResource QuickActionStyle}"
                                    Command="{Binding ImportMarkdownCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="14"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontSize="12.5" Text="Import Markdown"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource SmallMutedTextStyle}"
                                                   Text="Turn a .md file into a note" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource QuickActionStyle}"
                                    Command="{Binding ShowFilesCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontSize="12.5" Text="Browse files"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource SmallMutedTextStyle}"
                                                   Text="Images and attachments stored here" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource QuickActionStyle}"
                                    Command="{Binding ShowTrashCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontSize="12.5" Text="Open the trash"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource SmallMutedTextStyle}"
                                                   Text="Restore or permanently remove notes" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Margin="0,26,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SmallMutedTextStyle}"
                           Text="{Binding VersionText}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
