<UserControl x:Class="NotedX.Desktop.Views.TransfersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="368"
             d:DesignWidth="368">

    <Border Style="{StaticResource DialogCardStyle}" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" FontSize="15" Text="Transfers" />
                    <TextBlock Style="{StaticResource SmallMutedTextStyle}"
                               Text="Files sent from paired devices" />
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                           Style="{StaticResource SmallIconButtonStyle}"
                           ToolTip="Close"
                           Command="{Binding ToggleTransfersCommand}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                </ui:Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="380">
                <ItemsControl ItemsSource="{Binding Transfers.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="10" CornerRadius="9"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{Binding FileName}" />
                                        <ui:SymbolIcon Grid.Column="1" Symbol="Checkmark24" FontSize="12"
                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                       Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>

                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource SmallMutedTextStyle}"
                                               Text="{Binding StatusText}" />

                                    <ProgressBar Height="4" Margin="0,7,0,0"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisibility}}" />

                                    <Grid Margin="0,5,0,0">
                                        <TextBlock Style="{StaticResource SmallMutedTextStyle}"
                                                   Text="{Binding ProgressText}" />
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource SmallMutedTextStyle}"
                                                       Text="{Binding SpeedText}" />
                                            <TextBlock Margin="6,0,0,0" Style="{StaticResource SmallMutedTextStyle}"
                                                       Text="{Binding EtaText}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="0,10,0,10"
                        Visibility="{Binding Transfers.HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="20"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Style="{StaticResource SmallMutedTextStyle}"
                           Text="No transfers yet. Uploads from paired phones show up here live." />
            </StackPanel>

            <Grid Grid.Row="2">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource SmallMutedTextStyle}"
                           Text="{Binding Transfers.ActiveCount, Mode=OneWay, StringFormat='Active uploads: {0}'}" />
                <ui:Button HorizontalAlignment="Right"
                           Appearance="Transparent" Padding="8,3" CornerRadius="6" FontSize="11.5"
                           Content="Clear completed"
                           Command="{Binding Transfers.ClearCompletedCommand}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
