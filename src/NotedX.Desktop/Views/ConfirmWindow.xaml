<ui:FluentWindow
    x:Class="NotedX.Desktop.Views.ConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Confirm"
    Width="440"
    MinWidth="0"
    MinHeight="0"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    Background="Transparent"
    UseLayoutRounding="True"
    FontFamily="{StaticResource BodyFontFamily}"
    FontSize="14"
    PreviewKeyDown="OnWindowPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="HeaderBar"
                     Grid.Row="0"
                     Title="Confirm"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowHelp="False" />

        <Grid Grid.Row="1" Margin="26,6,26,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="38" Height="38"
                    CornerRadius="19"
                    VerticalAlignment="Top"
                    Background="{StaticResource BrandSoftBrush}">
                <ui:SymbolIcon Symbol="QuestionCircle24"
                               FontSize="17"
                               Foreground="{StaticResource BrandBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock x:Name="TitleText"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="Confirm" />

                <TextBlock x:Name="MessageText"
                           Margin="0,6,0,0"
                           FontSize="13"
                           LineHeight="19"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <ui:Button x:Name="CancelButton"
                               MinWidth="92"
                               Content="Cancel"
                               Click="OnCancelClick" />

                    <ui:Button x:Name="ConfirmButton"
                               MinWidth="92"
                               Margin="8,0,0,0"
                               Appearance="Primary"
                               Content="Yes"
                               Click="OnConfirmClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
