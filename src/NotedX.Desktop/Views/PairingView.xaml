<UserControl x:Class="NotedX.Desktop.Views.PairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="760">

    <Grid>
        <Button Style="{StaticResource OverlayBackdropButtonStyle}"
                Command="{Binding ClosePairingCommand}" />

        <Border Width="840"
                MaxHeight="680"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Style="{StaticResource DialogCardStyle}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="26,22,20,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" FontSize="20" Text="Pair a phone" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource MutedTextStyle}"
                                   Text="Scan the code once. The phone keeps access until you revoke it." />
                    </StackPanel>

                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                               Style="{StaticResource IconButtonStyle}"
                               ToolTip="Close"
                               Command="{Binding ClosePairingCommand}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                    </ui:Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,0,22,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="318" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Padding="0" CornerRadius="12">
                                <Grid Width="226" Height="226" HorizontalAlignment="Center">
                                    <Border Background="White" CornerRadius="10" Padding="10"
                                            Visibility="{Binding Pairing.HasActiveSession, Converter={StaticResource BoolToVisibility}}">
                                        <Image Source="{Binding Pairing.QrCode}"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Stretch="Uniform" />
                                    </Border>

                                    <Border CornerRadius="10"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            Visibility="{Binding Pairing.HasActiveSession, Converter={StaticResource InverseBoolToVisibility}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Margin="20">
                                            <ui:SymbolIcon Symbol="QrCode24" FontSize="30"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Text="{Binding Pairing.RemainingText}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center"
                                        Visibility="{Binding Pairing.HasPin, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource SmallMutedTextStyle}"
                                           Text="Confirm this PIN on the phone" />
                                <Border Margin="0,6,0,0"
                                        Padding="16,6"
                                        CornerRadius="9"
                                        Background="{StaticResource BrandSofterBrush}">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="25"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrandBrush}"
                                               Text="{Binding Pairing.Pin}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       Text="{Binding Pairing.RemainingText}"
                                       Visibility="{Binding Pairing.HasActiveSession, Converter={StaticResource BoolToVisibility}}" />

                            <Border Margin="0,14,0,0" Style="{StaticResource SoftCardStyle}" Padding="10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="PAIRING LINK" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11"
                                               MaxHeight="36"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Pairing.Link}" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:Button Grid.Column="0" Height="34" CornerRadius="8"
                                           Appearance="Secondary"
                                           Content="New code"
                                           IsEnabled="{Binding Pairing.IsBusy, Converter={StaticResource InverseBool}}"
                                           Command="{Binding Pairing.GenerateCommand}" />
                                <ui:Button Grid.Column="2" Height="34" CornerRadius="8"
                                           Appearance="Primary"
                                           Content="Copy link"
                                           Command="{Binding Pairing.CopyLinkCommand}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="HOW IT WORKS" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="{StaticResource BrandSoftBrush}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrandBrush}" Text="1" />
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Connect the phone to the same Wi-Fi as this PC." />
                            </Grid>

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="{StaticResource BrandSoftBrush}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrandBrush}" Text="2" />
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Scan the QR code, or type the pairing link in the phone's browser." />
                            </Grid>

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="{StaticResource BrandSoftBrush}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrandBrush}" Text="3" />
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Enter the four-digit PIN when the page asks for it. That is it." />
                            </Grid>

                            <Border Margin="0,16,0,0" Style="{StaticResource SoftCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="THIS PC'S ADDRESS" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{Binding Pairing.AddressText}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource SmallMutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="Open this address directly if scanning is not convenient." />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="11"
                                    CornerRadius="9"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    Visibility="{Binding Pairing.HasWarning, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="14"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Pairing.WarningText}" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Shield24" FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource SmallMutedTextStyle}"
                                               Text="Windows Firewall" />
                                </StackPanel>
                                <ui:Button HorizontalAlignment="Right"
                                           Appearance="Transparent"
                                           Padding="8,3"
                                           CornerRadius="6"
                                           FontSize="11.5"
                                           Content="Allow private networks"
                                           Command="{Binding Pairing.AllowFirewallCommand}" />
                            </Grid>

                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="{Binding Pairing.FirewallStatus}" />

                            <Grid Margin="0,18,0,0">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Text="PAIRED DEVICES" />
                                <ui:Button HorizontalAlignment="Right"
                                           Style="{StaticResource SmallIconButtonStyle}"
                                           ToolTip="Refresh devices"
                                           Command="{Binding Pairing.RefreshDevicesCommand}">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="11" />
                                </ui:Button>
                            </Grid>

                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Pairing.Devices}"
                                          Visibility="{Binding Pairing.HasDevices, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock FontSize="15" VerticalAlignment="Center"
                                                           Text="{Binding Icon}" />

                                                <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource SmallMutedTextStyle}"
                                                               Text="{Binding DetailsText}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock VerticalAlignment="Center"
                                                               Style="{StaticResource SmallMutedTextStyle}"
                                                               Text="{Binding StatusText}"
                                                               Visibility="{Binding IsRevoked, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:Button Appearance="Transparent"
                                                               Padding="8,3"
                                                               CornerRadius="6"
                                                               FontSize="11"
                                                               Content="Revoke"
                                                               Visibility="{Binding IsRevoked, Converter={StaticResource InverseBoolToVisibility}}"
                                                               Command="{Binding DataContext.Pairing.RevokeCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       Text="No devices paired yet. Generate a code above to get started."
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Pairing.HasDevices, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
