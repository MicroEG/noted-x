<UserControl x:Class="NotedX.Desktop.Views.SearchOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700"
             PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="SearchResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="9" Padding="9,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button Style="{StaticResource OverlayBackdropButtonStyle}"
                Command="{Binding CloseSearchCommand}" />

        <Border Width="640"
                MaxHeight="560"
                Margin="0,84,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Style="{StaticResource DialogCardStyle}"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Symbol="Search24" FontSize="16"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <ui:TextBox x:Name="SearchBox"
                                Grid.Column="1"
                                Margin="10,0,8,0"
                                Height="38"
                                FontSize="15.5"
                                Background="Transparent"
                                BorderThickness="0"
                                PlaceholderText="Search titles and content…"
                                ClearButtonEnabled="True"
                                Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Grid.Column="2" Style="{StaticResource PillStyle}" Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SmallMutedTextStyle}" Text="Esc" />
                    </Border>
                </Grid>

                <ProgressBar Grid.Row="1" Height="2" Margin="2,8,2,0" IsIndeterminate="True"
                             Visibility="{Binding Search.IsSearching, Converter={StaticResource BoolToVisibility}}" />

                <Grid Grid.Row="1" Margin="2,8,2,0">
                    <ListBox x:Name="ResultsList"
                             ItemsSource="{Binding Search.Results}"
                             ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="380"
                             SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding Search.HasSearched, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="32" Height="32" CornerRadius="8"
                                            Background="{StaticResource BrandSofterBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="14" Text="{Binding Icon}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{Binding Title}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="32"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Snippet}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Top" Margin="0,3,0,0"
                                               Style="{StaticResource SmallMutedTextStyle}"
                                               Text="{Binding UpdatedText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,34,0,34"
                                Visibility="{Binding Search.IsEmptyQuery, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Type a word from a title, heading, or paragraph." />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   Text="Search never leaves this computer." />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,34,0,34"
                                Visibility="{Binding Search.HasNoResults, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Nothing matched that search." />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   Text="Try fewer words or a different spelling." />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="2,8,2,0">
                    <TextBlock Style="{StaticResource SmallMutedTextStyle}"
                               Text="↑ ↓ choose · Enter open · Esc close" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SmallMutedTextStyle}"
                               Text="Full-text index on this PC" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
