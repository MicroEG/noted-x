<UserControl x:Class="NotedX.Desktop.Views.BlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:NotedX.Desktop.ViewModels"
             xmlns:domain="clr-namespace:NotedX.Core.Domain;assembly=NotedX.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="60"
             Focusable="False">

    <Grid>
        <!-- Text, headings, lists, quotes, and to-dos -->
        <Grid Margin="0,1"
              Visibility="{Binding IsTextual, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Top">
                <Border Width="3"
                        Margin="0,3,14,3"
                        CornerRadius="2"
                        Background="{StaticResource BrandBrush}"
                        VerticalAlignment="Stretch"
                        Visibility="{Binding ShowsQuoteBar, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Width="24"
                           Margin="0,2,8,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="17"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="•"
                           Visibility="{Binding ShowsBullet, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Width="24"
                           Margin="0,3,8,0"
                           TextAlignment="Right"
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding ListNumber}"
                           Visibility="{Binding ShowsNumber, Converter={StaticResource BoolToVisibility}}" />

                <CheckBox Margin="0,4,10,0"
                          VerticalAlignment="Top"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Grid Grid.Column="1">
                <TextBox x:Name="EditorBox"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="OnTextChanged"
                         PreviewKeyDown="OnBlockPreviewKeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource BlockTextBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="{x:Static domain:BlockType.Heading1}">
                                    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
                                    <Setter Property="FontSize" Value="27" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Margin" Value="0,10,0,2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="{x:Static domain:BlockType.Heading2}">
                                    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
                                    <Setter Property="FontSize" Value="21" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Margin" Value="0,8,0,1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="{x:Static domain:BlockType.Heading3}">
                                    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
                                    <Setter Property="FontSize" Value="17" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Margin" Value="0,6,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="{x:Static domain:BlockType.Quote}">
                                    <Setter Property="FontStyle" Value="Italic" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Setter Property="Margin" Value="0,2,0,2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock IsHitTestVisible="False"
                           Margin="1,2,0,0"
                           VerticalAlignment="Top"
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding Placeholder}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Popup x:Name="SlashPopup"
                       IsOpen="{Binding IsSlashMenuOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=EditorBox}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Width="286"
                            Margin="0,4,0,0"
                            Style="{StaticResource DialogCardStyle}"
                            Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding SlashItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SlashItemButtonStyle}"
                                                Click="OnSlashItemClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26" Height="26" CornerRadius="7"
                                                        Background="{StaticResource BrandSofterBrush}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="{StaticResource BrandBrush}"
                                                               Text="{Binding Glyph}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               Text="{Binding Title}" />
                                                    <TextBlock Style="{StaticResource SmallMutedTextStyle}"
                                                               Text="{Binding Description}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- Code -->
        <Border Margin="0,4"
                Style="{StaticResource SoftCardStyle}"
                Padding="12"
                Visibility="{Binding IsCode, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid Margin="2,0,2,7">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="CODE" />
                    <ui:TextBox Width="128"
                                Height="27"
                                HorizontalAlignment="Right"
                                FontSize="11.5"
                                PlaceholderText="language"
                                Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBox x:Name="CodeBox"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="12.5"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         Style="{StaticResource BlockTextBoxStyle}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="OnTextChanged"
                         PreviewKeyDown="OnBlockPreviewKeyDown" />
            </StackPanel>
        </Border>

        <!-- Divider -->
        <Border Height="1"
                Margin="0,15"
                Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                Visibility="{Binding IsDivider, Converter={StaticResource BoolToVisibility}}" />

        <!-- Image -->
        <Border Margin="0,6"
                Style="{StaticResource CardBorderStyle}"
                Padding="12"
                Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid MinHeight="90">
                    <Border CornerRadius="8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Padding="6">
                        <Image Source="{Binding PreviewImage}"
                               MaxHeight="440"
                               Stretch="Uniform"
                               Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibility}}" />
                    </Border>

                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource SmallMutedTextStyle}"
                               Text="Loading preview…"
                               Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource SmallMutedTextStyle}"
                               Text="{Binding PreviewError}"
                               Visibility="{Binding HasPreviewError, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsRemoteImage, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="Link24" FontSize="18"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SmallMutedTextStyle}"
                                   Text="Linked image from Markdown. Download it and attach it to keep a local copy." />
                    </StackPanel>
                </Grid>

                <Grid Margin="2,8,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Symbol="Image24" FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12.5"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding AttachmentName}" />
                        <TextBlock Style="{StaticResource SmallMutedTextStyle}" Text="{Binding AttachmentSizeText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary" Padding="10,4" CornerRadius="6" FontSize="11.5"
                                   Content="Open" Click="OnOpenMediaClick" />
                        <ui:Button Margin="6,0,0,0" Appearance="Secondary" Padding="10,4" CornerRadius="6" FontSize="11.5"
                                   Content="Replace" Click="OnReplaceImageClick" />
                        <ui:Button Margin="6,0,0,0" Appearance="Transparent" Padding="10,4" CornerRadius="6" FontSize="11.5"
                                   Content="Remove" Click="OnRemoveMediaClick" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- File -->
        <Border Margin="0,4"
                Style="{StaticResource CardBorderStyle}"
                Padding="12"
                Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="38" Height="38" CornerRadius="9"
                        Background="{StaticResource BrandSofterBrush}"
                        VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Attach24" FontSize="16"
                                   Foreground="{StaticResource BrandBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding AttachmentName}" />
                    <TextBlock Style="{StaticResource SmallMutedTextStyle}" Text="{Binding AttachmentSizeText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary" Padding="10,4" CornerRadius="6" FontSize="11.5"
                               Content="Open" Click="OnOpenMediaClick" />
                    <ui:Button Margin="6,0,0,0" Appearance="Transparent" Padding="10,4" CornerRadius="6" FontSize="11.5"
                               Content="Remove" Click="OnRemoveMediaClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Table -->
        <Border Margin="0,4"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Visibility="{Binding IsTable, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding TableRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="150"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1,1,0,1">
                                                    <TextBox Style="{StaticResource CellTextBoxStyle}"
                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ui:Button Margin="4,0,0,0"
                                               Style="{StaticResource SmallIconButtonStyle}"
                                               ToolTip="Remove row"
                                               Click="OnRemoveTableRowClick">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="10" />
                                    </ui:Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" Padding="9,3" CornerRadius="6" FontSize="11.5"
                               Content="Add row" Click="OnAddTableRowClick" />
                    <ui:Button Margin="6,0,0,0" Appearance="Secondary" Padding="9,3" CornerRadius="6" FontSize="11.5"
                               Content="Add column" Click="OnAddTableColumnClick" />
                    <ui:Button Margin="6,0,0,0" Appearance="Transparent" Padding="9,3" CornerRadius="6" FontSize="11.5"
                               Content="Remove column" Click="OnRemoveTableColumnClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
