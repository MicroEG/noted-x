<UserControl x:Class="NotedX.Desktop.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="880"
             d:DesignHeight="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
              MaxWidth="820" Margin="44,30,44,18" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="STORAGE" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource PageTitleStyle}" Text="Files" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}"
                           Text="Images, documents, and uploads received from paired devices. Stored once, even when reused." />
            </StackPanel>

            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Appearance="Secondary"
                       Padding="12,6"
                       CornerRadius="8"
                       Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="13" />
                    <TextBlock Margin="7,0,0,0" Text="Refresh" />
                </StackPanel>
            </ui:Button>
        </Grid>

        <ProgressBar Grid.Row="1"
                     Height="3"
                     Margin="44,0,44,8"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <ItemsControl Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                          MaxWidth="820" Margin="44,0,44,40" HorizontalAlignment="Center"
                          ItemsSource="{Binding Items}"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Style="{StaticResource CardBorderStyle}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="38" Height="38" CornerRadius="9"
                                        Background="{StaticResource BrandSofterBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="17" Text="{Binding Icon}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{Binding FileName}" />
                                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource SmallMutedTextStyle}" Text="{Binding SizeText}" />
                                        <TextBlock Margin="6,0" Style="{StaticResource SmallMutedTextStyle}" Text="·" />
                                        <TextBlock Style="{StaticResource SmallMutedTextStyle}" Text="{Binding AddedText}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Appearance="Secondary" Padding="12,5" CornerRadius="7" FontSize="12"
                                               Content="Open"
                                               Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Margin="6,0,0,0" Appearance="Transparent" Padding="12,5" CornerRadius="7" FontSize="12"
                                               Content="Show note"
                                               Visibility="{Binding HasPage, Converter={StaticResource BoolToVisibility}}"
                                               Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Margin="6,0,0,0" Appearance="Transparent" Padding="9,5" CornerRadius="7"
                                               ToolTip="Remove from the workspace"
                                               Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                               CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="12" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <Border Width="54" Height="54" CornerRadius="14"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="22"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center"
                       Style="{StaticResource SectionTitleStyle}" Text="No files yet" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Attach images or files inside a note, or send them from a paired phone." />
        </StackPanel>
    </Grid>
</UserControl>
