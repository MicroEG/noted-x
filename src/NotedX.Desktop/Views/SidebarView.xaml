<UserControl x:Class="NotedX.Desktop.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:NotedX.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="260"
             d:DesignHeight="720">

    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:PageTreeNodeViewModel}" ItemsSource="{Binding Children}">
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Text="{Binding Icon}" />

                <TextBlock Grid.Column="1"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Title}" />

                <TextBlock Grid.Column="2"
                           Margin="6,0,2,0"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrandBrush}"
                           Text="★"
                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </HierarchicalDataTemplate>

        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource PageTreeItemStyle}" />

        <Style x:Key="FavoriteButtonStyle" TargetType="Button" BasedOn="{StaticResource SlashItemButtonStyle}">
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource LayerFillColorAltBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
        <Grid Margin="10,8,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Expanded sidebar -->
            <Grid Grid.RowSpan="3" Margin="0,2,0,0"
                  Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <Image Height="38"
                               HorizontalAlignment="Left"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/Assets/logo.png" />
                        <TextBlock Margin="1,6,0,0"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   Text="Private workspace" />
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Style="{StaticResource IconButtonStyle}"
                               ToolTip="Collapse sidebar"
                               Command="{Binding ToggleSidebarCommand}">
                        <ui:SymbolIcon Symbol="PanelLeftContract24" FontSize="14" />
                    </ui:Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,2,0">
                    <StackPanel>

                        <ui:Button Height="36"
                                   Appearance="Secondary"
                                   CornerRadius="8"
                                   HorizontalContentAlignment="Stretch"
                                   Padding="10,0"
                                   Command="{Binding OpenSearchCommand}"
                                   ToolTip="Search notes (Ctrl+K)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Search24" FontSize="14"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Search" />
                                <Border Grid.Column="2" Style="{StaticResource PillStyle}" Padding="6,1">
                                    <TextBlock Style="{StaticResource SmallMutedTextStyle}" Text="Ctrl K" />
                                </Border>
                            </Grid>
                        </ui:Button>

                        <ui:Button Margin="0,8,0,0"
                                   Height="36"
                                   Appearance="Primary"
                                   CornerRadius="8"
                                   HorizontalContentAlignment="Stretch"
                                   Padding="10,0"
                                   Command="{Binding NewPageCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" />
                                <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="SemiBold" Text="New note" />
                            </Grid>
                        </ui:Button>

                        <StackPanel Margin="0,14,0,0">
                            <RadioButton GroupName="SidebarNav"
                                         Style="{StaticResource SidebarNavStyle}"
                                         IsChecked="{Binding IsHomeVisible, Mode=OneWay}"
                                         Command="{Binding ShowHomeCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Home24" FontSize="15" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="Home" />
                                </Grid>
                            </RadioButton>

                            <RadioButton GroupName="SidebarNav"
                                         Margin="0,2,0,0"
                                         Style="{StaticResource SidebarNavStyle}"
                                         IsChecked="{Binding IsFilesVisible, Mode=OneWay}"
                                         Command="{Binding ShowFilesCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="15" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="Files" />
                                </Grid>
                            </RadioButton>

                            <RadioButton GroupName="SidebarNav"
                                         Margin="0,2,0,0"
                                         Style="{StaticResource SidebarNavStyle}"
                                         IsChecked="{Binding IsTrashVisible, Mode=OneWay}"
                                         Command="{Binding ShowTrashCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="Trash" />
                                    <Border Grid.Column="2"
                                            Style="{StaticResource NavBadgeStyle}"
                                            Visibility="{Binding HasTrash, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrandBrush}"
                                                   Text="{Binding TrashCount}" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Margin="0,18,0,0"
                                    Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Margin="10,0,0,6" Style="{StaticResource SectionLabelStyle}" Text="FAVORITES" />
                            <ItemsControl ItemsSource="{Binding Favorites}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource FavoriteButtonStyle}"
                                                Command="{Binding DataContext.OpenNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="13" VerticalAlignment="Center" Text="{Binding Icon}" />
                                                <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding Title}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Margin="0,18,0,4">
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource SectionLabelStyle}" Text="NOTES" />
                            <ui:Button HorizontalAlignment="Right"
                                       Style="{StaticResource SmallIconButtonStyle}"
                                       ToolTip="New note"
                                       Command="{Binding NewPageCommand}">
                                <ui:SymbolIcon Symbol="Add24" FontSize="12" />
                            </ui:Button>
                        </Grid>

                        <TreeView x:Name="PageTree"
                                  ItemsSource="{Binding Pages}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0"
                                  Margin="0,0,0,8"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  MaxHeight="520" />

                        <TextBlock Margin="10,2,10,10"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="No notes yet. Create one, or import a Markdown file."
                                   Visibility="{Binding HasAnyPages, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <ui:Button Height="52"
                               Appearance="Secondary"
                               CornerRadius="10"
                               HorizontalContentAlignment="Stretch"
                               Padding="10,0"
                               Command="{Binding OpenPairingCommand}"
                               ToolTip="Pair a phone on your network">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="8"
                                    Background="{StaticResource BrandSofterBrush}">
                                <ui:SymbolIcon Symbol="Phone24" FontSize="14"
                                               Foreground="{StaticResource BrandBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="Pair a phone" />
                                <TextBlock Style="{StaticResource SmallMutedTextStyle}" Text="Open your notes on Wi-Fi" />
                            </StackPanel>
                        </Grid>
                    </ui:Button>

                    <Grid Margin="6,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServerRunning}" Value="False">
                                            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding ServerSummary}" />

                        <ui:Button Grid.Column="2"
                                   Style="{StaticResource SmallIconButtonStyle}"
                                   ToolTip="Settings"
                                   Command="{Binding OpenSettingsCommand}">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="13" />
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Collapsed rail -->
            <Grid Grid.RowSpan="3"
                  Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <Image Width="30"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/Assets/logomark.png" />
                    <ui:Button Margin="0,6,0,0"
                               Style="{StaticResource SmallIconButtonStyle}"
                               ToolTip="Expand sidebar"
                               Command="{Binding ToggleSidebarCommand}">
                        <ui:SymbolIcon Symbol="PanelLeftExpand24" FontSize="12" />
                    </ui:Button>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <ui:Button Width="34" Height="34" Margin="0,0,0,6"
                               Appearance="Primary"
                               CornerRadius="8"
                               Padding="0"
                               ToolTip="New note"
                               Command="{Binding NewPageCommand}">
                        <ui:SymbolIcon Symbol="Add24" FontSize="15" />
                    </ui:Button>

                    <RadioButton GroupName="RailNav" Style="{StaticResource RailNavStyle}"
                                 IsChecked="{Binding IsHomeVisible, Mode=OneWay}"
                                 ToolTip="Home"
                                 Command="{Binding ShowHomeCommand}">
                        <ui:SymbolIcon Symbol="Home24" FontSize="16" />
                    </RadioButton>

                    <RadioButton GroupName="RailNav" Style="{StaticResource RailNavStyle}"
                                 IsChecked="{Binding IsFilesVisible, Mode=OneWay}"
                                 ToolTip="Files"
                                 Command="{Binding ShowFilesCommand}">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="16" />
                    </RadioButton>

                    <RadioButton GroupName="RailNav" Style="{StaticResource RailNavStyle}"
                                 IsChecked="{Binding IsTrashVisible, Mode=OneWay}"
                                 ToolTip="Trash"
                                 Command="{Binding ShowTrashCommand}">
                        <Grid>
                            <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                            <Ellipse Width="6" Height="6" Margin="0,0,6,6"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Fill="{StaticResource BrandBrush}"
                                     Visibility="{Binding HasTrash, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </RadioButton>

                    <RadioButton GroupName="RailNav" Style="{StaticResource RailNavStyle}"
                                 ToolTip="Search (Ctrl+K)"
                                 Command="{Binding OpenSearchCommand}">
                        <ui:SymbolIcon Symbol="Search24" FontSize="16" />
                    </RadioButton>

                    <RadioButton GroupName="RailNav" Style="{StaticResource RailNavStyle}"
                                 ToolTip="Pair a phone"
                                 Command="{Binding OpenPairingCommand}">
                        <ui:SymbolIcon Symbol="Phone24" FontSize="16" />
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                    <RadioButton GroupName="RailNav" Style="{StaticResource RailNavStyle}"
                                 ToolTip="Settings"
                                 Command="{Binding OpenSettingsCommand}">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                    </RadioButton>
                    <Ellipse Width="7" Height="7" Margin="0,6,0,4" HorizontalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Setter Property="ToolTip" Value="{Binding ServerSummary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerRunning}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
