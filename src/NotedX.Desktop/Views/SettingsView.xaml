<UserControl x:Class="NotedX.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="760">

    <Grid>
        <Button Style="{StaticResource OverlayBackdropButtonStyle}"
                Command="{Binding CloseSettingsCommand}" />

        <Border Width="700"
                MaxHeight="660"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Style="{StaticResource DialogCardStyle}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="26,22,20,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" FontSize="20" Text="Settings" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource MutedTextStyle}"
                                   Text="Appearance, pairing security, network, and storage." />
                    </StackPanel>

                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                               Style="{StaticResource IconButtonStyle}"
                               ToolTip="Close"
                               Command="{Binding CloseSettingsCommand}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                    </ui:Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,0,22,8">
                    <StackPanel>

                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="APPEARANCE" />
                        <Border Margin="0,8,0,0" Style="{StaticResource CardBorderStyle}" Padding="14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="Dark theme" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource SmallMutedTextStyle}">
                                        <Run Text="Currently " />
                                        <Run Text="{Binding Settings.ThemeLabel, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Settings.IsDark, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,20,0,0" Style="{StaticResource SectionLabelStyle}" Text="PAIRING SECURITY" />
                        <Border Margin="0,8,0,0" Style="{StaticResource CardBorderStyle}" Padding="14">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="Require a four-digit PIN" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource SmallMutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Settings.PinStatusText}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                                     IsChecked="{Binding Settings.RequirePairingPin, Mode=TwoWay}" />
                                </Grid>

                                <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="8"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Style="{StaticResource SmallMutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="Pairing codes expire after two minutes. Device tokens are stored hashed and can be revoked from the pairing dialog." />
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,20,0,0" Style="{StaticResource SectionLabelStyle}" Text="NETWORK" />
                        <Border Margin="0,8,0,0" Style="{StaticResource CardBorderStyle}" Padding="14">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="Local server" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource SmallMutedTextStyle}"
                                                   Text="{Binding Settings.ListeningText}" />
                                    </StackPanel>
                                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Appearance="Secondary" Padding="10,4" CornerRadius="6" FontSize="11.5"
                                               Content="Copy address"
                                               Command="{Binding Settings.CopyAddressCommand}" />
                                </Grid>

                                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="ADDRESS" />
                                        <TextBlock Margin="0,3,0,0" FontSize="12.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{Binding Settings.ServerAddress}" />
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SmallMutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Settings.AddressesText}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,8,0,0" Style="{StaticResource SmallMutedTextStyle}"
                                           Text="{Binding Settings.DiscoveryText}" />

                                <Separator Margin="0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="Use HTTPS" />
                                        <TextBlock Margin="0,3,0,10" Style="{StaticResource SmallMutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Settings.HttpsStatusText}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     IsChecked="{Binding Settings.UseHttps, Mode=TwoWay}" />
                                </Grid>

                                <Border Padding="10,8" CornerRadius="8"
                                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                        Visibility="{Binding Settings.ShowRestartHint, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Warning24" FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        <TextBlock Margin="8,0,0,0" FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="Restart noted-x to apply the HTTPS change." />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Shield24" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource SmallMutedTextStyle}"
                                                   Text="Windows Firewall" />
                                    </StackPanel>
                                    <ui:Button HorizontalAlignment="Right"
                                               Appearance="Secondary" Padding="10,4" CornerRadius="6" FontSize="11.5"
                                               Content="Allow private networks"
                                               Command="{Binding Settings.AllowFirewallCommand}" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource SmallMutedTextStyle}"
                                           TextWrapping="Wrap"
                                           Text="{Binding Settings.FirewallStatus}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,20,0,0" Style="{StaticResource SectionLabelStyle}" Text="STORAGE" />
                        <Border Margin="0,8,0,0" Style="{StaticResource CardBorderStyle}" Padding="14">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="Your data folder" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource SmallMutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Settings.DataFolder}" />
                                    </StackPanel>
                                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Appearance="Secondary" Padding="10,4" CornerRadius="6" FontSize="11.5"
                                               Command="{Binding Settings.OpenDataFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="OpenFolder24" FontSize="12" />
                                            <TextBlock Margin="6,0,0,0" Text="Open folder" />
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource SmallMutedTextStyle}" Text="Largest upload" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{Binding Settings.MaxFileText}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,4" Style="{StaticResource SoftCardStyle}" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="14"
                                               VerticalAlignment="Top"
                                               Foreground="{StaticResource BrandBrush}" />
                                <TextBlock Margin="9,0,0,0" FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="No cloud. No telemetry. No accounts. Notes, files, and device tokens never leave this PC." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="26,8,22,18">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SmallMutedTextStyle}"
                               Text="{Binding VersionText}" />
                    <ui:Button HorizontalAlignment="Right"
                               Appearance="Primary" Padding="16,6" CornerRadius="8"
                               Content="Done"
                               Command="{Binding CloseSettingsCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
